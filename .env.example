POSTGRES_PASSWORD=replace-with-a-strong-local-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Local email testing uses Mailpit from compose.yaml.
# For real delivery, replace these with your SMTP provider settings.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLE=false
MAIL_FROM=no-reply@nexora.local
EMAIL_VERIFICATION_BASE_URL=http://localhost:5173/verify-email
